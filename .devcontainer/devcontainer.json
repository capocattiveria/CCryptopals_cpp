{
  "name": "Cryptopals dev",
  "dockerComposeFile": "../compose.yaml",
  "service": "dev",
  "workspaceFolder": "/app",
  "shutdownAction": "stopCompose",
  "customizations": {
    "vscode": {
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd",
        "anthropic.claude-code"
      ],
      "settings": {
        "C_Cpp.intelliSenseEngine": "disabled",
        "clangd.inlayHints.toggle": false,
        "clangd.serverArgs": [
          "--inlay-hints=0"
        ]
      }
    }
  },
  "remoteUser": "ubuntu"
}